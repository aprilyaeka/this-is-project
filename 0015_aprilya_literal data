print("1. buatlah deklarasi dalam python")
# deklarasi variabel nama dengan type data string
nama = "aprilya eka nurfadilah"
print("nama         : ",nama)
# deklarasi variabel umur dengan type data integer
umur = "19"
print("umur         : ",umur,"tahun")
#deklarasi variabel berat dengan type data float 
berat = "54.5"
print("berat        : ",berat,"kg")
# tugas nomer-2
print("ubah tipe data berikut")
angka_string  = "123"
angka_float   = 45.67
angka_integer = 89

# 1. konversi angka_string menjadi integer
data_1           = int(angka_string )
# 2. konversi angka_float menjadi integer
data_2          = int(angka_float )
# 3. konversi angka_integer menjadi float
data_3           = float(angka_integer)
# 4. konversi angka_integer menjadi string
data_4          = str(angka_integer)

print(data_1,type(data_1))
print(data_2,type(data_2))
print(data_3,type(data_3))
print(data_4,type(data_4))

